{
  "name": "fetch-feedback",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute fetch-feedback --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute fetch-feedback --remote --file=./schema.sql",
    "qr": "node scripts/generate-qr.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode": "^1.5.4",
    "vite": "^6.0.0",
    "wrangler": "^4.92.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
