{
  "name": "fetch-feedback",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute fetch-feedback --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute fetch-feedback --remote --file=./schema.sql",
    "qr": "node scripts/generate-qr.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "npm run test:unit && npm run test:vlite && npm run test:catalogue && npm run test:sales && npm run test:whatsapp && npm run test:whatsapp-send && npm run test:whatsapp-webhook && npm run test:vnetra && npm run test:qr && npm run test:sql && npm run test:vnetra-sheet && npm run test:ledger",
    "test:unit": "node tests/inventory-unit.mjs",
    "//test:ledger": "Hits the LOCAL D1 and wipes the ledger. Stop `wrangler dev` first \u2014 both want a write lock on the same SQLite file.",
    "test:ledger": "bash tests/ledger-invariants.sh",
    "db:inventory": "wrangler d1 execute fetch-feedback --remote --file=./migrations/004_inventory.sql",
    "db:inventory:local": "wrangler d1 execute fetch-feedback --local --file=./migrations/004_inventory.sql",
    "db:auth": "wrangler d1 execute fetch-feedback --remote --file=./migrations/002_admin_auth.sql",
    "test:vlite": "node tests/vlite-unit.mjs",
    "//test:api": "Needs `wrangler dev --port 8810` running. test:conc stops it at the end.",
    "test:api": "bash tests/inward-api.sh && bash tests/outward-api.sh",
    "test:conc": "bash tests/concurrency-api.sh",
    "test:catalogue": "node tests/catalogue-unit.mjs",
    "test:sales": "node tests/sales-unit.mjs",
    "test:whatsapp": "node tests/whatsapp-unit.mjs",
    "test:whatsapp-send": "node tests/whatsapp-send-unit.mjs",
    "test:whatsapp-webhook": "node tests/whatsapp-webhook-unit.mjs",
    "db:whatsapp-delivery": "wrangler d1 execute fetch-feedback --remote --file=./migrations/010_whatsapp_delivery.sql",
    "db:whatsapp-inbound": "wrangler d1 execute fetch-feedback --remote --file=./migrations/011_whatsapp_inbound.sql",
    "db:whatsapp-replies": "wrangler d1 execute fetch-feedback --remote --file=./migrations/012_whatsapp_replies.sql",
    "db:whatsapp-canned": "wrangler d1 execute fetch-feedback --remote --file=./migrations/013_whatsapp_canned.sql",
    "db:whatsapp-header": "wrangler d1 execute fetch-feedback --remote --file=./migrations/014_whatsapp_header.sql",
    "db:whatsapp-media": "wrangler d1 execute fetch-feedback --remote --file=./migrations/015_whatsapp_media.sql",
    "db:whatsapp-send": "wrangler d1 execute fetch-feedback --remote --file=./migrations/009_whatsapp_send.sql",
    "db:whatsapp-send:local": "wrangler d1 execute fetch-feedback --local --file=./migrations/009_whatsapp_send.sql",
    "test:vnetra": "node tests/vnetra-unit.mjs",
    "test:qr": "node tests/qr-unit.mjs",
    "test:sql": "node tests/sql-shape-unit.mjs",
    "db:qr": "wrangler d1 execute fetch-feedback --remote --file=./migrations/016_qr_codes.sql",
    "test:vnetra-sheet": "node tests/vnetra-sheet-unit.mjs",
    "db:vnetra-exports": "wrangler d1 execute fetch-feedback --remote --file=./migrations/008_vnetra_exports.sql",
    "db:vnetra-exports:local": "wrangler d1 execute fetch-feedback --local --file=./migrations/008_vnetra_exports.sql",
    "db:vnetra": "wrangler d1 execute fetch-feedback --remote --file=./migrations/007_vnetra.sql",
    "db:vnetra:local": "wrangler d1 execute fetch-feedback --local --file=./migrations/007_vnetra.sql",
    "db:whatsapp": "wrangler d1 execute fetch-feedback --remote --file=./migrations/006_whatsapp_optin.sql",
    "db:whatsapp:local": "wrangler d1 execute fetch-feedback --local --file=./migrations/006_whatsapp_optin.sql",
    "db:prices": "wrangler d1 execute fetch-feedback --remote --file=./migrations/005_prices_and_sales.sql"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "wrangler": "^4.92.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
